# Copy to .env (local) or set in your host's build settings. All values are public —
# Vite bakes them into the JavaScript, so never put a secret here.

# The sarvam_donation_management API (no trailing slash).
#   test:  https://api-test-donation.sarvamangaleducationtrust.org
#   local: http://localhost:9997   (the port in sarvam_donation_management's app.js)
VITE_API_BASE_URL=https://api-test-donation.sarvamangaleducationtrust.org

# Easebuzz checkout environment: "test" or "prod".
# Must match the API's payment_config.yaml (EASEBUZZ_BASE_URL testpay.easebuzz.in = test,
# pay.easebuzz.in = prod), or the checkout window will reject the access key.
VITE_EASEBUZZ_ENV=test

# The main website (no trailing slash). Logo, "Back to website" and the
# privacy / terms / contact links point here.
#   local main site: http://localhost:3000
VITE_MAIN_SITE_URL=https://sarvamangaleducationtrust.org
